<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1">
<title>MARAUDERmt</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Stencil+Text:wght@400;500;600;700;800;900&family=Share+Tech+Mono&display=swap" rel="stylesheet">
<script src="https://unpkg.com/mqtt/dist/mqtt.min.js"></script>
<link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A//www.w3.org/2000/svg%22%20viewBox%3D%220%200%20100%20100%22%3E%3Crect%20width%3D%22100%22%20height%3D%22100%22%20fill%3D%22black%22/%3E%3Cpath%20d%3D%22M50%206%20L92%2050%20L50%2094%20L8%2050%20Z%22%20stroke%3D%22red%22%20stroke-width%3D%225%22%20fill%3D%22none%22/%3E%3Cline%20x1%3D%2250%22%20y1%3D%226%22%20x2%3D%2250%22%20y2%3D%2294%22%20stroke%3D%22red%22%20stroke-width%3D%225%22/%3E%3Cline%20x1%3D%228%22%20y1%3D%2250%22%20x2%3D%2292%22%20y2%3D%2250%22%20stroke%3D%22red%22%20stroke-width%3D%225%22/%3E%3Cpath%20d%3D%22M28%2028%20L50%2050%20L28%2072%22%20stroke%3D%22red%22%20stroke-width%3D%225%22%20fill%3D%22none%22/%3E%3Cpath%20d%3D%22M72%2028%20L50%2050%20L72%2072%22%20stroke%3D%22red%22%20stroke-width%3D%225%22%20fill%3D%22none%22/%3E%3C/svg%3E">
<style>
  :root{
    --red-core:#ff0000;
    --red-mid:#cc0000;
    --red-dim:#3a0000;
    --dim-red:#ff2b2b;
    --bg:#000000;
    --panel-bg:#0a0a0a;
    --text:#ffffff;
    --live:#2ecc40;
    --mono:'Share Tech Mono', ui-monospace, 'Courier New', monospace;
    --stencil:'Big Shoulders Stencil Text', sans-serif;
    --red-glow: rgba(255,0,0,.6);
  }
  @media (prefers-reduced-motion: reduce){
    *{ animation-duration: 0.001ms !important; animation-iteration-count: 1 !important; transition-duration: 0.001ms !important; }
  }
  *{ box-sizing:border-box; }
  html,body{ height:100%; }
  body{
    margin:0;
    background:
      radial-gradient(ellipse at 50% -10%, rgba(255,0,0,0.06), transparent 55%),
      var(--bg);
    color:var(--text);
    font-family:var(--stencil);
    overflow:hidden;
    -webkit-font-smoothing:antialiased;
  }
  .mono{ font-family:var(--mono) !important; }

  /* ---------- ambient layers ---------- */
  .grid-overlay{
    position:fixed; inset:0; pointer-events:none; z-index:1;
    background-image:
      linear-gradient(rgba(255,0,0,0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,0,0,0.05) 1px, transparent 1px);
    background-size: 34px 34px;
    mask-image: radial-gradient(ellipse at 50% 40%, black 55%, transparent 95%);
  }
  .scanlines{
    position:fixed; inset:0; pointer-events:none; z-index:3; opacity:0.5;
    background: repeating-linear-gradient(
      to bottom, rgba(0,0,0,0) 0px, rgba(0,0,0,0) 1px,
      rgba(0,0,0,0.2) 2px, rgba(0,0,0,0.2) 3px
    );
    mix-blend-mode:multiply;
  }
  .scan-sweep{
    position:fixed; left:0; right:0; height:120px; z-index:3; pointer-events:none;
    background:linear-gradient(to bottom, transparent, rgba(255,0,0,0.05), transparent);
    animation: sweep 7s linear infinite;
  }
  @keyframes sweep{ 0%{ top:-120px; } 100%{ top:100%; } }
  .vignette{
    position:fixed; inset:0; pointer-events:none; z-index:4;
    box-shadow: inset 0 0 160px rgba(0,0,0,0.9), inset 0 0 60px rgba(0,0,0,0.65);
  }
  .noise-flash{
    position:fixed; inset:0; z-index:50; pointer-events:none; opacity:0;
    background:repeating-linear-gradient(0deg, rgba(255,0,0,0.55) 0 1px, transparent 1px 3px);
  }
  .noise-flash.active{ opacity:0.9; animation: flashout 0.5s steps(6) forwards; }
  @keyframes flashout{ 0%{opacity:0.9;} 100%{opacity:0;} }

  /* ---------- screens ---------- */
  .screen{ position:relative; z-index:2; height:100vh; width:100vw; display:none; }
  .screen.active{ display:flex; }

  /* ===== AUTH / emblem header ===== */
  #auth-screen{ align-items:center; justify-content:center; flex-direction:column; padding:20px; }

  .marauder-header{
    width:min(460px, 92vw);
    border:2px solid var(--red-core);
    background:#000;
    padding:22px 18px 18px;
    text-align:center;
    position:relative;
    box-shadow:0 0 24px rgba(255,0,0,.16), inset 0 -10px 30px rgba(255,0,0,.05);
    animation: bootIn 0.6s ease-out both, mdrBoxPulse 3.6s ease-in-out infinite;
    overflow:hidden;
  }
  @keyframes mdrBoxPulse{
    0%,100%{ box-shadow:0 0 24px rgba(255,0,0,.16), inset 0 -10px 30px rgba(255,0,0,.05); }
    50%{ box-shadow:0 0 44px rgba(255,0,0,.36), inset 0 -10px 34px rgba(255,0,0,.1); }
  }
  @keyframes bootIn{ from{ opacity:0; transform:translateY(8px) scale(0.99);} to{opacity:1; transform:none;} }

  .stencil-corner{ position:absolute; width:9px; height:9px; border-color:#fff; opacity:.7; }
  .stencil-corner.tl{ left:12px; top:12px; border-top:1px solid; border-left:1px solid; }
  .stencil-corner.tr{ right:12px; top:12px; border-top:1px solid; border-right:1px solid; }
  .stencil-corner.bl{ left:12px; bottom:12px; border-bottom:1px solid; border-left:1px solid; }
  .stencil-corner.br{ right:12px; bottom:12px; border-bottom:1px solid; border-right:1px solid; }

  .top-emblem{
    width:44px; height:44px; margin:0 auto 6px; display:block;
    filter:drop-shadow(0 0 8px rgba(255,0,0,.55));
  }
  .top-emblem path, .top-emblem line{ stroke:var(--red-core); stroke-width:2; fill:none; }

  .marauder-name{
    font-family:var(--stencil);
    font-size:clamp(30px,7vw,48px);
    line-height:.95; letter-spacing:7px; color:#fff; text-transform:none;
    position:relative; animation:mdrGlow 3.6s ease-in-out infinite;
  }
  @keyframes mdrGlow{
    0%,100%{ text-shadow:2px 2px 0 var(--red-dim), 0 0 14px rgba(255,0,0,.75), 0 0 34px rgba(255,0,0,.35); }
    50%{ text-shadow:2px 2px 0 var(--red-dim), 0 0 22px rgba(255,0,0,.95), 0 0 50px rgba(255,0,0,.55); }
  }
  .marauder-comms{
    font-family:var(--stencil);
    font-size:clamp(13px,3.2vw,19px);
    letter-spacing:8px; color:#fff; text-transform:none;
    margin-top:-2px; position:relative;
    animation: mdrGlow 3.6s ease-in-out infinite;
  }
  .marauder-sub{ margin-top:6px; color:var(--dim-red); font-size:9px; letter-spacing:4px; text-transform:uppercase; font-family:var(--mono); }
  .marauder-tag{ margin-top:14px; font-size:10px; letter-spacing:2px; color:var(--dim-red); text-transform:uppercase; font-family:var(--mono); }

  .auth-fields{ width:min(460px, 92vw); margin-top:16px; }
  .key-actions{ display:flex; gap:8px; margin-top:8px; flex-wrap:wrap; }
  .key-gen-note{ font-size:10px; color:var(--live); margin-top:7px; min-height:13px; line-height:1.4; letter-spacing:0.5px; font-family:var(--mono); text-transform:uppercase; }
  .field-label{ font-size:10px; letter-spacing:2px; color:var(--dim-red); margin:14px 0 6px; display:flex; justify-content:space-between; text-transform:uppercase; font-family:var(--mono); }
  input[type=text], input[type=password]{
    width:100%; background:#0a0a0a; border:1px solid rgba(255,255,255,.35);
    color:#fff; font-family:var(--stencil); font-size:15px; letter-spacing:1px;
    padding:10px 12px; outline:none;
  }
  input[type=text]:focus, input[type=password]:focus{ border-color:var(--red-core); box-shadow:0 0 0 1px var(--red-core), 0 0 10px var(--red-glow); }
  input::placeholder{ color:#666; font-family:var(--mono); letter-spacing:0; }

  .hint{ font-size:10.5px; color:#8a8a8a; margin-top:6px; line-height:1.5; font-family:var(--mono); }

  .btn{
    font-family:var(--mono); letter-spacing:1.5px; text-transform:uppercase;
    background:transparent; border:1px solid var(--red-core); color:#fff;
    padding:11px 16px; cursor:pointer; font-size:12px; font-weight:bold;
    clip-path:polygon(8px 0,100% 0,100% calc(100% - 8px),calc(100% - 8px) 100%,0 100%,0 8px);
    transition: background 0.15s, color 0.15s, box-shadow 0.15s;
  }
  .btn:hover{ background:var(--red-core); color:#000; box-shadow:0 0 12px var(--red-glow); }
  .btn:active{ transform:translateY(1px); }
  .btn.wide{ width:100%; margin-top:20px; }
  .btn.solid{ background:var(--red-core); color:#000; }
  .btn.solid:hover{ background:#fff; }
  .btn.ghost{ border-color:rgba(255,255,255,.35); }
  .btn.small{ padding:7px 11px; font-size:10px; }

  .err-line{ color:var(--dim-red); font-size:11px; margin-top:10px; min-height:14px; letter-spacing:0.5px; font-family:var(--mono); }

  /* ===== MAIN ===== */
  #main-screen{ flex-direction:column; }
  .topbar{
    display:flex; align-items:center; justify-content:space-between; gap:10px; flex-wrap:wrap;
    padding:10px 16px; border-bottom:2px solid var(--red-core);
    background:#000; position:relative; overflow:hidden;
    box-shadow:0 0 20px rgba(255,0,0,.1);
  }
  .topbar::after{
    content:""; position:absolute; left:-30%; top:0; bottom:0; width:30%; pointer-events:none;
    background:linear-gradient(90deg, transparent, rgba(255,0,0,.3), transparent);
    mix-blend-mode:screen; animation:mdrSweep 5s linear infinite;
  }
  @keyframes mdrSweep{ 0%{left:-30%;} 100%{left:100%;} }

  .brand{ display:flex; align-items:center; gap:10px; }
  .brand-emblem{ width:26px; height:26px; filter:drop-shadow(0 0 6px rgba(255,0,0,.6)); }
  .brand-emblem path, .brand-emblem line{ stroke:var(--red-core); stroke-width:3; fill:none; }
  .brand-mark{ font-family:var(--stencil); color:#fff; font-weight:700; font-size:17px; letter-spacing:2px; text-shadow:1px 1px 0 var(--red-dim), 0 0 8px rgba(255,0,0,.5); }
  .brand-sub{ font-size:9px; color:var(--dim-red); letter-spacing:2px; font-family:var(--mono); text-transform:uppercase; }

  .status-cluster{ display:flex; align-items:center; gap:16px; font-size:10px; color:var(--dim-red); flex-wrap:wrap; font-family:var(--mono); text-transform:uppercase; letter-spacing:1px; }
  .status-item{ display:flex; align-items:center; gap:6px; }
  .status-item.live{ color:var(--live); }
  .blinkdot{ display:inline-block; width:7px; height:7px; border-radius:50%; background:var(--red-core); box-shadow:0 0 10px var(--red-core), 0 0 22px rgba(255,0,0,.5); animation:pulse 1.4s infinite; }
  .status-item.live .blinkdot{ background:var(--live); box-shadow:0 0 10px var(--live), 0 0 22px rgba(46,204,64,.5); }
  @keyframes pulse{0%,100%{opacity:1;}50%{opacity:.25;}}

  .toolrow{ display:flex; gap:8px; position:relative; z-index:2; }

  .log-wrap{ flex:1; overflow-y:auto; padding:16px 18px 8px; position:relative; }
  .log-wrap::-webkit-scrollbar{ width:8px; }
  .log-wrap::-webkit-scrollbar-thumb{ background:var(--red-dim); }

  .sys-line{ font-size:11px; color:var(--dim-red); margin:4px 0 10px; letter-spacing:0.5px; font-family:var(--mono); }
  .msg{ margin-bottom:16px; max-width:78%; animation:msgIn 0.25s ease-out both; }
  @keyframes msgIn{ from{ opacity:0; transform:translateY(4px);} to{opacity:1; transform:none;} }
  .msg.self{ margin-left:auto; }
  .msg-meta{ display:flex; gap:10px; font-size:10px; margin-bottom:4px; letter-spacing:0.5px; font-family:var(--mono); text-transform:uppercase; }
  .msg.self .msg-meta{ justify-content:flex-end; }
  .msg-callsign{ font-weight:bold; color:var(--dim-red); text-shadow:0 0 6px rgba(255,0,0,.7); }
  .msg.self .msg-callsign{ color:#fff; }
  .msg-time{ color:#8a8a8a; }
  .msg-body{
    border:1px solid var(--red-mid); padding:9px 12px; font-size:11px; line-height:1.5;
    background:var(--panel-bg); word-break:break-word; position:relative; color:#e8e8e8;
    font-family:var(--mono);
  }
  .msg.self .msg-body{ border-color: var(--red-core); background:#0d0000; }
  .msg-body.fail{ color:var(--dim-red); border-color:rgba(255,43,43,0.5); background:rgba(255,0,0,0.05); font-size:11px; }
  .cipher-peek{ font-size:9.5px; color:#6b6b6b; margin-top:5px; word-break:break-all; opacity:0.9; display:none; font-family:var(--mono); }
  .cipher-peek.show{ display:block; }

  .composer{
    display:flex; gap:10px; padding:14px 16px; border-top:1px solid var(--red-mid);
    background:#050000;
  }
  .prompt-caret{ color:var(--red-core); align-self:center; font-weight:700; font-family:var(--mono); }
  #msg-input{ flex:1; }
  .footnote{ padding:6px 16px 10px; font-size:9px; color:var(--dim-red); letter-spacing:1px; display:flex; justify-content:space-between; flex-wrap:wrap; gap:6px; font-family:var(--mono); text-transform:uppercase; }

  @media (max-width: 640px){
    .msg{ max-width:92%; }
    .status-cluster{ display:none; }
  }
</style>
</head>
<body>

<div class="grid-overlay"></div>
<div class="scan-sweep"></div>
<div class="scanlines"></div>
<div class="vignette"></div>
<div class="noise-flash" id="noise-flash"></div>

<!-- ================= AUTH SCREEN ================= -->
<div class="screen active" id="auth-screen">
  <div class="marauder-header">
    <span class="stencil-corner tl"></span><span class="stencil-corner tr"></span>
    <span class="stencil-corner bl"></span><span class="stencil-corner br"></span>
    <svg class="top-emblem" viewBox="0 0 100 100" aria-label="MARAUDERmt emblem">
      <path d="M50 6 L92 50 L50 94 L8 50 Z"/>
      <line x1="50" y1="6" x2="50" y2="94"/>
      <line x1="8" y1="50" x2="92" y2="50"/>
      <path d="M28 28 L50 50 L28 72"/>
      <path d="M72 28 L50 50 L72 72"/>
    </svg>
    <div class="marauder-name">MARAUDERmt</div>
    <div class="marauder-comms">COMMS</div>
    <div class="marauder-sub">SECURE COMMS UPLINK</div>
    <div class="marauder-tag">3&times; AES-256-GCM CASCADE &middot; LOCAL KEY DERIVATION &middot; NO SERVER LOG</div>
  </div>

  <div class="auth-fields">
    <div class="field-label"><span>Callsign</span><span id="callsign-count">0/16</span></div>
    <input type="text" id="callsign-input" maxlength="16" placeholder="e.g. WIDOW-6" autocomplete="off">

    <div class="field-label"><span>Cipher Key</span><span>Shared Passphrase</span></div>
    <input type="password" id="key-input" placeholder="passphrase — shared with your contact" autocomplete="off">
    <div class="key-actions">
      <button type="button" class="btn ghost small" id="gen-key-btn">Generate Key</button>
      <button type="button" class="btn ghost small" id="show-key-btn">Show</button>
      <button type="button" class="btn ghost small" id="copy-key-btn">Copy</button>
    </div>
    <div class="key-gen-note" id="key-gen-note"></div>
    <div class="hint"><strong>Messages relay through broker.emqx.io, a free public MQTT broker — anyone who guesses or obtains your passphrase can join your channel, and the relay operator can see channel names and traffic timing even though payloads are encrypted.</strong> Stretched locally via PBKDF2 (100,000 rounds, three independent salts) into three separate AES-256-GCM keys. Every message is sealed under key 1, that ciphertext sealed again under key 2, then sealed a third time under key 3 — each layer with its own random IV. Keys never leave this device; anyone without the exact same passphrase sees only a failed decryption. The same passphrase also selects your private channel — anyone with it, on any device, anywhere, joins the same link automatically.</div>

    <button class="btn wide solid" id="establish-btn">Establish Link</button>
    <div class="err-line" id="auth-err"></div>
  </div>
</div>

<!-- ================= MAIN SCREEN ================= -->
<div class="screen" id="main-screen">
  <div class="topbar">
    <div class="brand">
      <svg class="brand-emblem" viewBox="0 0 100 100" aria-hidden="true">
        <path d="M50 6 L92 50 L50 94 L8 50 Z"/>
        <line x1="50" y1="6" x2="50" y2="94"/>
        <line x1="8" y1="50" x2="92" y2="50"/>
        <path d="M28 28 L50 50 L28 72"/>
        <path d="M72 28 L50 50 L72 72"/>
      </svg>
      <div>
        <div class="brand-mark">MARAUDERmt</div>
        <div class="brand-sub" id="callsign-display">CALLSIGN —</div>
      </div>
    </div>
    <div class="status-cluster">
      <div class="status-item live" id="link-status"><span class="blinkdot"></span> LINK ACTIVE</div>
      <div class="status-item">CHAN: <span id="channel-tag">——</span></div>
    </div>
    <div class="toolrow">
      <button class="btn ghost small" id="peek-toggle">Show Cipher</button>
      <button class="btn ghost small" id="relay-btn">Ping Relay</button>
      <button class="btn small" id="wipe-btn">Wipe Log</button>
    </div>
  </div>

  <div class="log-wrap" id="log-wrap">
    <div class="sys-line">&gt; LINK ESTABLISHED. KEY DERIVED LOCALLY. NO DATA WRITTEN TO DISK.</div>
    <div class="sys-line">&gt; ANYONE — ON ANY DEVICE, ANY NETWORK — WHO ESTABLISHES A LINK WITH THE SAME CIPHER KEY WILL APPEAR HERE LIVE. ONLY CIPHERTEXT EVER TOUCHES THE RELAY.</div>
  </div>

  <div class="composer">
    <span class="prompt-caret">&gt;</span>
    <input type="text" id="msg-input" placeholder="compose transmission..." autocomplete="off" maxlength="500">
    <button class="btn" id="send-btn">Transmit</button>
  </div>
  <div class="footnote">
    <span>MEMORY ONLY — NOTHING PERSISTS ON WIPE OR RELOAD</span>
    <span id="clock">00:00:00Z</span>
  </div>
</div>

<script>
(() => {
  "use strict";

  /* ---------------- crypto core ---------------- */
  const enc = new TextEncoder();
  const dec = new TextDecoder();

  const SALT_LAYERS = [
    "MARAUDER-SECCOMM-STATIC-SALT-v1-L1",
    "MARAUDER-SECCOMM-STATIC-SALT-v1-L2",
    "MARAUDER-SECCOMM-STATIC-SALT-v1-L3",
  ];

  async function deriveSingleKey(passphrase, saltStr) {
    const material = await crypto.subtle.importKey(
      "raw", enc.encode(passphrase), "PBKDF2", false, ["deriveKey"]
    );
    return crypto.subtle.deriveKey(
      { name: "PBKDF2", salt: enc.encode(saltStr), iterations: 100000, hash: "SHA-256" },
      material,
      { name: "AES-GCM", length: 256 },
      false,
      ["encrypt", "decrypt"]
    );
  }

  // Three independently-salted AES-256-GCM keys from the same passphrase —
  // each layer is encrypted under its own key with its own random IV.
  async function deriveKey(passphrase) {
    return Promise.all(SALT_LAYERS.map(salt => deriveSingleKey(passphrase, salt)));
  }

  async function deriveTopic(passphrase) {
    const digest = await crypto.subtle.digest("SHA-256", enc.encode("MARAUDER-SECCOMM-TOPIC-v1:" + passphrase));
    const hex = Array.from(new Uint8Array(digest)).map(b => b.toString(16).padStart(2, "0")).join("");
    return { full: "marauder-seccomm/v1/" + hex.slice(0, 32), fingerprint: hex.slice(0, 8).toUpperCase() };
  }

  function bufToB64(buf) {
    return btoa(String.fromCharCode(...new Uint8Array(buf)));
  }
  function b64ToBuf(b64) {
    return Uint8Array.from(atob(b64), c => c.charCodeAt(0));
  }

  async function encryptLayer(key, data) {
    const iv = crypto.getRandomValues(new Uint8Array(12));
    const ct = await crypto.subtle.encrypt({ name: "AES-GCM", iv }, key, data);
    const combined = new Uint8Array(iv.length + ct.byteLength);
    combined.set(iv, 0);
    combined.set(new Uint8Array(ct), iv.length);
    return combined;
  }

  async function decryptLayer(key, data) {
    const iv = data.slice(0, 12);
    const ct = data.slice(12);
    const plainBuf = await crypto.subtle.decrypt({ name: "AES-GCM", iv }, key, ct);
    return new Uint8Array(plainBuf);
  }

  // keys is an array of 3 independent AES-256-GCM keys — plaintext is sealed
  // under key[0], then that ciphertext is sealed again under key[1], then
  // under key[2]. Each layer has its own random 96-bit IV.
  async function encryptText(keys, plaintext) {
    let data = enc.encode(plaintext);
    for (const key of keys) {
      data = await encryptLayer(key, data);
    }
    return bufToB64(data.buffer);
  }

  async function decryptText(keys, b64) {
    let data = b64ToBuf(b64);
    for (let i = keys.length - 1; i >= 0; i--) {
      data = await decryptLayer(keys[i], data);
    }
    return dec.decode(data);
  }

  /* ---------------- app state ---------------- */
  const state = {
    keys: null,
    callsign: "",
    seen: new Set(),
    client: null,
    topic: null,
    clientId: "mdr-" + crypto.randomUUID(),
  };

  const MQTT_
